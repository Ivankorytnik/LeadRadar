APP_NAME=LeadRadar AI
APP_SECRET=change-me-in-production
BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./data/leadradar.db

# Live web search via Yandex Search API
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Optional second SERP provider (SerpAPI-compatible)
SERPAPI_KEY=
SERPAPI_ENDPOINT=https://serpapi.com/search.json

# Optional AI classification. Without these keys, heuristic scoring is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me

# SMTP email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Optional: enables a compact admin view for users registered with this email
ADMIN_EMAIL=

# 1 = create demo search results when no search API is configured
DEMO_MODE=1
